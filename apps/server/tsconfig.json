{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node", "bun"],
    // Why DOM: @xterm addon typings carry `/// <reference lib="dom"/>`, so
    // any import of them injects DOM globals anyway. Declaring the libs keeps
    // the global type set fixed regardless of which deps join the program.
    "lib": ["ES2023", "esnext.disposable", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "tsdown.config.ts", "scripts", "integration", "../../scripts/lib"]
}
